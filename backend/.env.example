# Selects the settings module: dev or prod. Defaults to dev.
DJANGO_ENV=dev
# Django signing key. Required in prod; dev falls back to an insecure placeholder.
SECRET_KEY=replace-with-a-long-random-string
# Database connection URL. Dev falls back to SQLite when empty.
DATABASE_URL=postgres://user:password@localhost:5432/spotter_eld
# OpenRouteService API key for routing and geocoding. Backend only.
ORS_API_KEY=your-openrouteservice-key
# Prod only: comma-separated extra hostnames Django will serve. Render's own onrender.com host is added automatically
# from RENDER_EXTERNAL_HOSTNAME, so this can stay empty unless you add a custom domain.
ALLOWED_HOSTS=
# Prod only: comma-separated frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=https://spotter-eld.vercel.app
# Prod only: proxies that append to X-Forwarded-For in front of Django, so the throttle sees the real client. 2 on Render.
NUM_PROXIES=1
