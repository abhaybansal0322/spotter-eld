# Base URL of the Django API, without the /api suffix. Requests go to ${VITE_API_URL}/api/...
# On Vercel, set it under Project Settings > Environment Variables (e.g. https://spotter-eld-api.onrender.com).
# Vite bakes it in at build time, so changing it needs a redeploy.
VITE_API_URL=http://localhost:8000
